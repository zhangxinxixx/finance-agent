{
  "name": "finance-agent-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "test": "npm run test:page-data-boundary && npm run test:source-reachability && npm run test:dashboard-research-brief && npm run test:markdown-viewer && npm run test:tradingview && npm run test:gold-v3-page-bindings && npm run test:pipeline-dag && npm run test:review-center-actions && npm run test:agent-inspection && npm run test:event-flow-api-contract && npm run test:event-flow-date-contract && npm run test:cme-options-decision-contract && npm run test:cme-missing-values-behavior && npm run test:live-strategy-contract && npm run test:shadow-evaluation-contract && npm run test:shadow-evaluation-history-contract && npm run test:reports && npm run test:report-qualification-behavior && npm run test:reports-request-dedupe && npm run test:research-identity && npm run test:gold-policy-reports && npm run test:gold-reading-navigation",
    "test:markdown-viewer": "node scripts/check-markdown-viewer.mjs",
    "test:tradingview": "node scripts/check-tradingview-chart.mjs",
    "test:gold-v3-page-bindings": "node scripts/check-gold-v3-page-bindings.mjs",
    "test:pipeline-dag": "node scripts/check-pipeline-dag-gold-mainline.mjs",
    "test:review-center-actions": "node scripts/check-review-center-actions.mjs",
    "test:agent-inspection": "node scripts/check-agent-inspection-contract.mjs",
    "test:event-flow-api-contract": "node scripts/check-event-flow-api-contract.mjs",
    "test:event-flow-date-contract": "node scripts/check-event-flow-date-contract.mjs",
    "test:cme-options-decision-contract": "node scripts/check-cme-options-decision-contract.mjs",
    "test:live-strategy-contract": "node scripts/check-live-strategy-contract.mjs && npm run test:strategy-qualification-behavior && npm run test:strategy-history-behavior",
    "test:strategy-qualification-behavior": "node scripts/check-strategy-qualification-behavior.mjs",
    "test:strategy-history-behavior": "node scripts/check-strategy-history-behavior.mjs",
    "test:shadow-evaluation-contract": "node scripts/check-shadow-evaluation-contract.mjs",
    "test:shadow-evaluation-history-contract": "node scripts/check-shadow-evaluation-history-contract.mjs",
    "test:reports": "node scripts/check-reports-page-contract.mjs",
    "test:reports-request-dedupe": "node scripts/check-reports-request-dedupe.mjs",
    "test:research-identity": "node scripts/check-research-identity-behavior.mjs && node scripts/check-gold-workspace.mjs && node scripts/check-research-trade-plan.mjs && node scripts/check-dashboard-research-brief.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:source-reachability": "node scripts/check-source-reachability.mjs",
    "test:dashboard-research-brief": "node scripts/check-dashboard-research-brief.mjs",
    "test:page-data-boundary": "node scripts/check-page-data-boundary.mjs",
    "test:cme-missing-values-behavior": "node scripts/check-cme-missing-values-behavior.mjs",
    "test:report-qualification-behavior": "node scripts/check-report-qualification-behavior.mjs",
    "test:gold-policy-reports": "node scripts/check-gold-policy-reports.mjs",
    "test:gold-reading-navigation": "node scripts/check-gold-reading-navigation.mjs",
    "test:report-api-bridge": "python -m pytest ../../tests/contracts/report_api_bridge.py -q --import-mode=importlib"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.5.0",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^6.3.5"
  }
}
