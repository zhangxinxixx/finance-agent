# Runtime data stays local, including newly introduced storage domains.
# Versioned regression samples belong in tests/fixtures/, not storage/.
/storage/**
!/storage/raw/
!/storage/raw/.gitkeep
!/storage/parsed/
!/storage/parsed/.gitkeep
!/storage/features/
!/storage/features/.gitkeep
!/storage/outputs/
!/storage/outputs/.gitkeep
logs/

# Local architecture analysis and language-server output.
# Keep reviewed documentation in docs/ and generation evidence in workbench.
/.codeboarding/

# Test fixtures can be committed, but not large PDFs over 5MB
tests/fixtures/**/*.pdf
!tests/fixtures/cme/.gitkeep

